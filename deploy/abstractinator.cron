# /etc/cron.d/abstractinator  -- scheduled jobs for The Abstractinator
# Install:  sudo cp deploy/abstractinator.cron /etc/cron.d/abstractinator
# Format:   minute hour day-of-month month day-of-week USER command
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Every day at 4:15am: pull new bioRxiv/medRxiv preprints into biorxiv_local_db/
15 4 * * * shiny cd /srv/shiny-server/abstractinator && /usr/bin/Rscript update_biorxiv_db.R >> logs/biorxiv_update.log 2>&1

# Every day at 4:45am: look up MeSH descriptors that searches queued (the website
# only reads the MeSH cache, so new descriptors wait for this)
45 4 * * * shiny cd /srv/shiny-server/abstractinator && /usr/bin/Rscript deploy/warm_mesh.R --pending >> logs/mesh_warm.log 2>&1

# Sundays at 11:30pm: snapshot the tracked ClinicalTrials.gov records (see
# tracker/snapshot_trials.py); search PubMed and NIH RePORTER for the
# clinical papers and grants that name each program (tracker/evidence.py);
# then rebuild the registry database: trial, paper and grant links, what
# changed, and the www/changes.html digest (tracker/build_registry.py).
# Separated by ";" so one failing step doesn't stop the rest: a failed
# evidence fetch leaves last week's file in place for the build.
# python3 -u so progress reaches the logs as it happens. The evidence fetch
# gives up after 45 minutes on its own (writing nothing); timeout is the backstop.
# History can't be fetched later, so a missed week is lost; the uptime probe
# alerts on a stale snapshot or evidence file. Check by hand:
#   python3 tracker/snapshot_trials.py --status; python3 tracker/evidence.py --status
30 23 * * 0 shiny cd /srv/shiny-server/abstractinator && /usr/bin/python3 -u tracker/snapshot_trials.py >> logs/trial_snapshots.log 2>&1; /usr/bin/timeout 60m /usr/bin/python3 -u tracker/evidence.py >> logs/evidence.log 2>&1; /usr/bin/python3 -u tracker/build_registry.py >> logs/registry_build.log 2>&1
