# Environment & Secrets
.Renviron

# Data & Evidence
data/
biorxiv_local_db/
*.csv
*.json

# Execution Cache & Targets
.cache/
_targets/
*.rds
.RData
.Rhistory

# Logging
logs/
*.log

# IDE & Infrastructure
__pycache__/
*.pyc
*.save
.Rproj.user/
# Static web assets are not data dumps
!www/*.json

# Shiny/bslib runtime cache
app_cache/
# Editing backups (file.R.bak, file.R.phasebak, ...)
*.bak
*.*bak*

# renv is used to RECORD versions (renv.lock), not to activate a project
# library. An .Rprofile here would auto-activate renv on the live server,
# where the project library is not populated for the service user.
.Rprofile
renv/

# Secrets live in ~/.config/abstractinator/, never in the tree. This is a
# guard against adding one here by accident.
*.env
